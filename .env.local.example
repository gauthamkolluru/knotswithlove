# ─── Sanity project (required) ────────────────────────────────────────────────
# Get these from https://sanity.io/manage after creating your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# ─── Revalidation webhook secret (required) ───────────────────────────────────
# Choose any random string. You'll enter this in Sanity webhook settings too.
SANITY_REVALIDATE_SECRET=your_random_secret_here

# ─── Contact form (required for message delivery) ───────────────────────────
SANITY_WRITE_TOKEN=your_sanity_write_token
RESEND_API_KEY=your_resend_api_key
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=hello@example.com
